{
  "name": "react-example",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/trade-browser-smoke.cjs",
    "test:appearance": "node tests/appearance-browser-smoke.cjs",
    "test:treasury": "node tests/treasury-browser-smoke.cjs",
    "test:branding": "node tests/branding-colors-browser-smoke.cjs",
    "test:consignment": "node tests/consignment-browser-smoke.cjs",
    "test:company-cash": "node tests/company-cash-browser-smoke.cjs",
    "test:navigation": "node tests/navigation-browser-smoke.cjs",
    "test:reports": "node tests/report-exports-browser-smoke.cjs",
    "test:workspace-polish": "node tests/workspace-polish-browser-smoke.cjs",
    "test:trade-center": "node tests/trade-center-browser-smoke.cjs",
    "test:compact-workspace": "node tests/compact-workspace-browser-smoke.cjs",
    "test:declutter": "node tests/declutter-browser-smoke.cjs",
    "test:smart-documents": "node tests/smart-documents-browser-smoke.cjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron out/desktop-app",
    "desktop:installer": "npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs --win nsis --x64 --publish never && node scripts/finalize-desktop.mjs",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs --win --x64 --dir --publish never",
    "test:desktop": "node tests/desktop-browser-smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "2.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "1.64.1",
    "resedit": "3.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "حسابداری برادران نبوی — نسخهٔ آزمایشی دسکتاپ و وب",
  "author": "شرکت تجارتی برادران نبوی",
